# Backend Environment Variables (Secrets - DO NOT EXPOSE TO FRONTEND)
# These variables are used by Python backend services (Flask API, Lambda functions, scripts).
# Keep these secure and never prefix them with VITE_.

## Supabase Configuration (Backend)
SUPABASE_URL=https://your-project.supabase.co
# Service role key - bypasses RLS, use only in backend
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Alternative name for service role key (both are checked)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Anon key (optional for backend, mainly for frontend)
SUPABASE_ANON_KEY=your-anon-key-here

## OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: specify GPT model (defaults to gpt-4o-mini)
GPT_MODEL=gpt-4o-mini
# Optional: custom OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

## Gmail IMAP Configuration (for resume collection)
GMAIL_EMAIL=your-email@gmail.com
# Create an App Password in your Google account (requires 2FA)
GMAIL_APP_PASSWORD=your-gmail-app-password-here
# Comma-separated keywords to match in email subjects
GMAIL_SEARCH_SUBJECTS=Applicant,Resume,Application
# Primary mailbox to search (falls back to All Mail if no matches)
GMAIL_PRIMARY_MAILBOX=INBOX
# Optional: limit emails processed per run
# MAX_EMAILS_PER_RUN=50

## SMTP Email Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail, use the same App Password as GMAIL_APP_PASSWORD
SMTP_PASSWORD=your-gmail-app-password-here
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Your Company Recruitment

## Token Configuration
# Hours before applicant access tokens expire
TOKEN_EXPIRY_HOURS=24

## App URL (for generating email links)
# This is used by the backend to generate applicant login links in emails
# For local development: http://localhost:5173
# For production: https://your-cloudfront-domain.com
APP_URL=http://localhost:5173

## Google Calendar API Configuration (for interview scheduling)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account

## FFmpeg Configuration (for video transcription)
# Set this if FFmpeg is not in your system PATH
# Windows example: D:\Downloads\ffmpeg-8.0.1-essentials_build\bin\ffmpeg.exe
# Mac/Linux example: /usr/local/bin/ffmpeg
# FFMPEG_PATH=/path/to/ffmpeg

## Flask API Configuration (for local development)
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=false

## Microsoft Teams Notifications (optional)
# Add Teams webhook URL if you want notifications
# TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/...

## Model Device Configuration (optional, for ML models)
# MODEL_DEVICE=cpu
