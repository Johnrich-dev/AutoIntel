# Frontend Environment Variables (Safe for Browser Bundle)
# These variables are prefixed with VITE_ and will be embedded in the client-side bundle.
# DO NOT include any secrets, API keys, or service role keys here.

## Backend API URL
# For local development: http://localhost:5000
# For production: https://your-api-gateway-url.execute-api.region.amazonaws.com/prod
VITE_API_URL=http://localhost:5000

## Frontend App URL (for redirects, etc.)
# For local development: http://localhost:5173
# For production: https://your-cloudfront-domain.com
VITE_APP_URL=http://localhost:5173

## Supabase Configuration (Public Keys Only)
# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, safe to expose)
# This key is designed to be used in the browser with Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SECURITY WARNING: NEVER add VITE_SUPABASE_SERVICE_ROLE_KEY here!
# Service role keys bypass RLS and must only be used in backend services.
