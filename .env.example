## Gmail IMAP (App Password)
# GMAIL_EMAIL=autointel.ta@gmail.com
# Create an App Password in your Google account (requires 2FA) and paste it here:
GMAIL_APP_PASSWORD=your_gmail_app_password_here

## Gmail search behavior
# Comma-separated keywords matched against the email subject.
GMAIL_SEARCH_SUBJECTS=Applicant,Application
# Primary mailbox to try first. Collector still prefers All Mail when available.
GMAIL_PRIMARY_MAILBOX=INBOX

## Collector batching
# Maximum number of unread emails processed per run
MAX_EMAILS_PER_RUN=20

## Supabase (service role key recommended for server scripts)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
